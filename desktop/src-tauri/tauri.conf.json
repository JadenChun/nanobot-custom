{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nanobot Desktop",
  "version": "0.3.0",
  "identifier": "org.nanobot.desktop",
  "build": {
    "beforeBuildCommand": "bun run --cwd ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "setup",
        "title": "Nanobot Desktop",
        "width": 650,
        "height": 720,
        "minWidth": 520,
        "minHeight": 620,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["setup-only"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "category": "Utility",
    "shortDescription": "Desktop shell for an installed Nanobot backend",
    "longDescription": "A thin desktop shell that connects to an existing compatible Nanobot Python installation.",
    "license": "MIT",
    "icon": ["icons/icon.png"],
    "resources": ["resources/backend-compat.json", "resources/THIRD_PARTY_NOTICES.md", "resources/LICENSE"],
    "linux": {
      "rpm": {
        "release": "3",
        "epoch": 0,
        "desktopTemplate": "nanobot.desktop",
        "depends": [
          "gtk3",
          "webkit2gtk4.1",
          "libappindicator-gtk3"
        ]
      }
    }
  }
}
