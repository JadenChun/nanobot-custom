  "findings": [
    {
      "id": "T01-F01",
      "priority": "P2",
      "title": "generic/external tool schemas can advertise constraints the local validator does not enforce",
      "conditional": false,
      "state": "promoted-report"
    },
    {
      "id": "T01-F02",
      "priority": "P2",
      "title": "loader registration is publication-atomic, not construction-lifetime atomic",
      "conditional": true,
      "state": "promoted-report"
    },
    {
      "id": "T01-F03",
      "priority": "P2",
      "title": "concurrent first-use foreground MCP initialization can silently omit configured tools",
      "conditional": false,
      "state": "promoted-report"
    },
    {
      "id": "T01-F04",
      "priority": "P1",
      "title": "remote MCP annotations can breach the delegated read-only authority boundary",
      "conditional": true,
      "state": "promoted-report"
    },
    {
      "id": "T01-F05",
      "priority": "P2",
      "title": "a failed MCP server setup can leave partially registered dead capabilities",
      "conditional": false,
      "state": "promoted-report"
    },
    {
      "id": "T01-F06",
      "priority": "P2",
      "title": "stdio MCP readiness has no deadline and serial startup can block the application indefinitely",
      "conditional": false,
      "state": "promoted-report"
    },
    {
      "id": "T01-F07",
      "priority": "P1",
      "title": "main browser/device file and working-directory authority bypasses workspace confinement",
      "conditional": true,
      "state": "promoted-report"
    },
    {
      "id": "T01-F08",
      "priority": "P1",
      "title": "desktop_use global input bypasses the main risky-action approval boundary",
      "conditional": true,
      "state": "promoted-report"
    },
    {
      "id": "T01-F09",
      "priority": "P2",
      "title": "generic owned-process cleanup does not prove descendant quiescence",
      "conditional": false,
      "state": "promoted-report"
    },
    {
      "id": "T01-F10",
      "priority": "P2",
      "title": "explicit foreground migration dropped the advertised apply_patch capability",
      "conditional": false,
      "state": "promoted-report"
    },
    {
      "id": "T01-F11",
      "priority": "P2",
      "title": "web_fetch output limits do not bound downloaded response bytes",
      "conditional": false,
      "state": "promoted-report"
    },
    {
      "id": "T01-F12",
      "priority": "P2",
      "title": "VPN session creation can outlive caller cancellation",
      "conditional": true,
      "state": "promoted-report"
    }
  ],
  "final_discussion_questions": [
    {
      "id": "T01-Q1",
      "question": "D2/D4: Should remote MCP read-only delegation trust annotations only from an explicit trusted server tier, or treat all annotations as non-authoritative hints?"
    },
    {
      "id": "T01-Q2",
      "question": "D4/P01: Should apply_patch be restored to the explicit core manifest after adopting the active write-lock owner, or should its guidance and dormant implementation be retired?"
    },
    {
      "id": "T01-Q3",
      "question": "D2/D7: Should enabling desktop_use constitute blanket pre-authorization for global input, or should it join the main risky-action approval boundary?"
    },
    {
      "id": "T01-Q4",
      "question": "D2/D4: Should browser/device cwd and file-output forms be routed through the same workspace/resource-policy authority as filesystem and shell tools?"
    },
    {
      "id": "T01-Q5",
      "question": "D5/D6: Should foreground MCP first-use readiness be owned by one shared initialization future with all concurrent callers awaiting the same outcome?"
    },
    {
      "id": "T01-Q6",
      "question": "D5/D6: Should per-server MCP setup stage wrappers until full server readiness and impose a bounded startup deadline, especially for stdio?"
    },
    {
      "id": "T01-Q7",
      "question": "D6: Should generic process ownership guarantee descendant quiescence before return on both Windows and POSIX, matching the stronger shell owner?"
    },
    {
      "id": "T01-Q8",
      "question": "D6/P01: Should web_fetch add a transport byte ceiling independent of model-visible maxChars, and should VPN broker calls move off cancellation-insensitive thread bridges?"
    }
